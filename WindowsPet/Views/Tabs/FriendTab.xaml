<UserControl x:Class="WindowsPet.Views.Tabs.FriendTab"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:WindowsPet.Views.Tabs"
             xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
             xmlns:uc="clr-namespace:WindowsPet.Views.Ucontrol"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes" xmlns:tabsvm="clr-namespace:WindowsPet.VM.TabsVM" d:DataContext="{d:DesignInstance Type=tabsvm:FriendTabVM}"
             mc:Ignorable="d" 
             >
    <Grid>


        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <TextBox
        Style="{StaticResource TextBoxTemplate}"
            Width="300"
        Margin="0,0,0,10"
        VerticalAlignment="Center"
        HorizontalAlignment="Left"
        materialDesign:HintAssist.Hint="請輸入您的名稱"
        materialDesign:HintAssist.Foreground="#edeeee"
        Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
        />
                <uc:SideButton Icon="AccountPlus" 
Command="{Binding AddFriendCommand}" 
/>
                
            </StackPanel>
        </Grid>
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Grid Grid.Column="0">
                <ListBox 
                    Style="{StaticResource CustomListBox}"
                     ItemContainerStyle="{StaticResource CustomListBoxItemStyle}"
    ItemsSource="{Binding PendingFriendRequest}"

   >
                    <ListBox.ItemTemplate>
                        <DataTemplate >
                            <Grid  >
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="auto"></ColumnDefinition>
                                    <ColumnDefinition Width="*"></ColumnDefinition>
                                    <ColumnDefinition Width="auto"></ColumnDefinition>

                                </Grid.ColumnDefinitions>
                                <Grid Grid.Column="0">
                                    <uc:SideButton Icon="Check" HorizontalAlignment="Left"  Command="{Binding DataContext.AcceptCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding }"></uc:SideButton>

                                </Grid>
                                <Grid Grid.Column="1">
                                    <TextBlock VerticalAlignment="Center" HorizontalAlignment="Center" Foreground="#edeeee" Text="{Binding FromUserName}" FontSize="20"/>

                                </Grid>
                                <Grid Grid.Column="2">
                                    <uc:SideButton Icon="Close" HorizontalAlignment="Right"  Command="{Binding DataContext.RejectCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding }"></uc:SideButton>

                                </Grid>
                            </Grid>
                           
                        </DataTemplate>
                    </ListBox.ItemTemplate>

                </ListBox>
            </Grid>
            <!-- 好友清單 -->
            <Grid Grid.Column="1">
                <ListBox 
    Style="{StaticResource CustomListBox}"
    ItemsSource="{Binding Friends}"

   >
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Name}" />
                        </DataTemplate>
                    </ListBox.ItemTemplate>

                </ListBox>
            </Grid>
            
        </Grid>



        <!-- 功能面板 -->



    </Grid>
</UserControl>
