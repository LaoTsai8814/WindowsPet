<UserControl x:Class="WindowsPet.Views.Tabs.BuyPetTab"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:WindowsPet.Views.Tabs"
             xmlns:uc="clr-namespace:WindowsPet.Views.Ucontrol"
             >
    
    <!--
        CurrentImage        Type=string
        PreviousImageCommand  Type=ICommand
        NextImageCommand      Type=ICommand
        Credit              Type=decimal
        Pet                 Type=Pet
    
    -->
    
        <Border Background="#1e2e44" CornerRadius="15" Padding="20" 
                >
            
            <!-- 如果你有自定義陰影樣式 -->
            <StackPanel Background="#1e2e44">
                <!-- 寵物圖片 -->
                <StackPanel Orientation="Horizontal">
                    <TextBlock HorizontalAlignment="Right" Style="{StaticResource TextblockStyle}" Text="{Binding Credit , StringFormat=總金額：{0:C}}"></TextBlock>
                </StackPanel>
                <uc:SwitchLRImageBox  PreviousImageCommand="{Binding PreviousImageCommand}" NextImageCommand="{Binding NextImageCommand}"></uc:SwitchLRImageBox>
                <!-- 名稱與描述 -->
                <TextBlock Style="{StaticResource TextblockStyle}" Text="{Binding Pet.Name}" />
                <TextBlock Style="{StaticResource TextblockStyle}" Text="{Binding Pet.Description}" TextWrapping="Wrap"/>
                
                <!-- 價格與數量 -->
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,0,10">
                    <TextBlock Style="{StaticResource TextblockStyle}" Text="單價：" FontWeight="SemiBold" />
                    <TextBlock Style="{StaticResource TextblockStyle}" Text="{Binding Pet.Price, StringFormat=C}"/>
                </StackPanel>
                
               

                <!-- 操作按鈕 -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <Button Content="返回" Style="{StaticResource Pagesidebutton}" Command="{Binding BackCommand}"  Margin="15"/>
                <Button Content="購買" Style="{StaticResource Pagesidebutton}" Command="{Binding BuyCommand}" CommandParameter="{Binding Pet.Id}" Margin="15"/>
                </StackPanel>
            </StackPanel>
        </Border>
    
</UserControl>
