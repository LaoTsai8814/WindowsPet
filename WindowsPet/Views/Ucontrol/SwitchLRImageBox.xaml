<UserControl x:Class="WindowsPet.Views.Ucontrol.SwitchLRImageBox"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:WindowsPet.Views.Ucontrol"
             xmlns:uc="clr-namespace:WindowsPet.Views.Ucontrol"
             xmlns:icon="http://metro.mahapps.com/winfx/xaml/iconpacks"
             xmlns:Tab="clr-namespace:WindowsPet.Views.Tabs"
             >
    <Grid Height="320" Margin="0,0,0,10">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="auto"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="auto"/>
        </Grid.ColumnDefinitions>

        <!-- 左箭頭 -->
        <uc:SideButton Icon="ArrowLeft" Grid.Column="0" Command="{Binding PreviousImageCommand,RelativeSource={RelativeSource AncestorType=local:SwitchLRImageBox}}"></uc:SideButton>

        <!-- 圖片 -->
        <Image Grid.Column="1"
           x:Name="AnimatedImage"
           HorizontalAlignment="Center"
           VerticalAlignment="Center"
        />
        

        <!-- 右箭頭 -->
        <uc:SideButton Grid.Column="2" Icon="ArrowRight" Command="{Binding NextImageCommand,RelativeSource={RelativeSource AncestorType=local:SwitchLRImageBox}}"></uc:SideButton>
    </Grid>
</UserControl>
