<UserControl x:Class="YourGodDamnPet.UControl.DisplayPet"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:YourGodDamnPet.UControl"
             >
    <Grid>
        <StackPanel>
            <TextBlock Text="{Binding PetSpeak}" Foreground="#EDEEEE" FontSize="50" HorizontalAlignment="Center"></TextBlock>
            <Image x:Name="PETImage" Width="150" Height="150"/>
        </StackPanel>
    </Grid>
</UserControl>
